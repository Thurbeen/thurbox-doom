#!/bin/sh
# DOOM for the thurbox pane.
#
# The pane runs THIS, under the `program` capability you granted it. Nothing here
# runs at install time — cloning a plugin puts files on your disk and executes none
# of them.
#
# Three ways it finds an engine, in order:
#
#   1. $THURBOX_DOOM_PROGRAM, if you set it. Yours wins.
#   2. `pi-doom` on PATH, if you already have one.
#   3. otherwise it fetches pi-doom once, into a cache OUTSIDE the interface
#      directory, and runs that.
#
# Why outside: the interface directory is watched recursively, and an `npm install`
# under it would fire thousands of events. A burst of them keeps the reload debounce
# rolling forward, so the interface would not reload MORE — it would stop reloading
# at all while the install ran. Keeping the working copy clean also matters: a dirty
# tree is what makes `thurbox-cli plugin update` report `kept` and refuse to move,
# so build output inside the clone would block your own updates.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
wad=${1:-"$root/wad/freedoom1.wad"}

if [ -n "${THURBOX_DOOM_PROGRAM:-}" ]; then
	exec "$THURBOX_DOOM_PROGRAM" "$wad"
fi
if command -v pi-doom >/dev/null 2>&1; then
	exec pi-doom "$wad"
fi

cache=${XDG_CACHE_HOME:-$HOME/.cache}/thurbox-doom
src=$cache/pi-doom
entry=$src/src/standalone.ts
tsx=$src/node_modules/.bin/tsx

missing=
for tool in git node npm; do
	command -v "$tool" >/dev/null 2>&1 || missing="$missing $tool"
done
if [ -n "$missing" ]; then
	echo "thurbox-doom: need$missing on PATH to fetch a DOOM engine." >&2
	echo "Install them, or point THURBOX_DOOM_PROGRAM at a terminal DOOM that" >&2
	echo "paints text cells and takes a WAD path as its last argument." >&2
	exit 1
fi

if [ ! -d "$src/.git" ]; then
	echo "thurbox-doom: fetching pi-doom into $src (once) ..."
	mkdir -p "$cache"
	git clone --depth 1 -q https://github.com/badlogic/pi-doom "$src"
fi
if [ ! -x "$tsx" ]; then
	echo "thurbox-doom: installing pi-doom's dependencies (once) ..."
	# `tsx` is what its own `npm start` reaches for through `npx`, which would PROMPT
	# to install it — and a prompt in a pane waits for a `y` nobody can see.
	(cd "$src" && npm install --silent --no-audit --no-fund && npm install --silent --no-save --no-audit --no-fund tsx)
fi

echo "thurbox-doom: starting DOOM with $wad"
exec "$tsx" "$entry" "$wad"
